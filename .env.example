# Copy this file to .env for local development only.
ENVIRONMENT=development

# Optional locally. Production requires a unique random value of at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite is for local development. Production must use PostgreSQL.
DATABASE_URL=sqlite:///./restaurante.db

# Comma-separated exact origins. Wildcard is rejected in production.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
